# ===== Recall 后端环境变量模板 =====
# 复制为 .env 并填入真实值：cp .env.example .env

# 【必填】硅基流动 API Key（LLM 归类/答疑/讲解 与 OCR 视觉模型共用，DeepSeek-OCR 免费）
RECALL_SILICONFLOW_API_KEY=sk-xxxx

# 【可选】模型与端点覆盖（默认值如下）
RECALL_SILICONFLOW_MODEL=THUDM/GLM-Z1-9B-0414
RECALL_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 【可选】CORS 允许来源（逗号分隔，默认含本地开发端口）
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
